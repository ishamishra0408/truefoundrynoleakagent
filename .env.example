# Copy to .env and fill in. .env is gitignored — never commit it.
MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MODEL_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
MODEL_NAME=gemini-2.5-flash

# TrueFoundry Secret Management — real source of the canary deploy secret (values are canaries)
TFY_HOST=https://<org>.truefoundry.cloud
TFY_API_KEY=PASTE_YOUR_TRUEFOUNDRY_PAT_HERE
TFY_SECRET_GROUP=shipwright-staging-deploy

# Canary token (fake). Must match DEPLOY_CANARY_TOKEN in the TrueFoundry secret group.
# Chosen to share no 8-char window with the repo/org name (see noleak/policy.mjs).
CANARY=CANARY-9f8a2c-QX7
